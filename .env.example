# Browser config: copy values into CONFIG at the top of script.js.
# Supabase project URL and anon/public key are safe for browser use with RLS enabled.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Trusted admin bootstrap only — never put this value in index.html or script.js.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
